# Copy to frontend/.env.local for local overrides (never commit .env.local).

# Run against the local Firebase emulators instead of the live project.
VITE_USE_EMULATORS=false
# VITE_EMULATOR_HOST=127.0.0.1

# reCAPTCHA Enterprise site key for App Check (leave empty until App Check is set up).
VITE_APPCHECK_SITE_KEY=

# Optional: point the app at a different Firebase project (defaults are the current project).
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
