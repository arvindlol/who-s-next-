rules_version = '2';

// Who's Next — Storage security rules.
// Only PDFs up to 10 MB can be uploaded, because screening and interview planning read PDFs only.
// Existing non-PDF files can still be read and deleted by their owner.

service firebase.storage {
  match /b/{bucket}/o {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isPdfUpload() {
      return request.resource.size > 0
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
    }

    // Job descriptions: users/{uid}/jobs/{jobId}/{file}.pdf
    match /users/{userId}/jobs/{jobId}/{fileName} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && isPdfUpload();
    }

    // Resumes: resumes/{uid}/{candidateId}-{timestamp}-{file}.pdf
    // (candidate IDs are 20-character Firestore auto-IDs)
    match /resumes/{userId}/{fileName} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && isPdfUpload()
        && fileName.matches('[A-Za-z0-9]{20}-.+');
    }
  }
}
