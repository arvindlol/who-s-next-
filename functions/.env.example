# Copy to functions/.env (deployed config) or functions/.env.local (emulator only).
# Do NOT put secrets here — GEMINI_KEY_ENCRYPTION_KEY is a Cloud Secret Manager secret:
#   firebase functions:secrets:set GEMINI_KEY_ENCRYPTION_KEY
# For the emulator, put it in functions/.secret.local instead (never commit that file).

# Gemini model IDs (defaults shown). Change here instead of editing code.
GEMINI_SCREENING_MODEL=gemini-3.8-flash
GEMINI_INTERVIEW_MODEL=gemini-3.7-flash
GEMINI_REPORT_MODEL=gemini-3.7-flash

# Set to true after App Check is configured (reCAPTCHA Enterprise) and the web app sends tokens.
ENFORCE_APP_CHECK=false

# Emulator only (.env.local): return fake Gemini responses so no key or network is needed.
# GEMINI_MOCK=true
